{
  "manifest_version": 3,
  "name": "Qualflare for GitHub — Test Health on PRs",
  "version": "0.1.0",
  "description": "See your Qualflare test health — pass/fail, flaky count, and AI summary — inline on GitHub pull requests.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.qualflare.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Qualflare — connect a repo",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/pull/*"],
      "js": ["src/lib/metrics.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/popup.html"],
      "matches": ["https://github.com/*"]
    }
  ]
}
